{
  "name": "bank-data",
  "version": "0.0.1",
  "license": "Apache-2.0",
  "type": "module",
  "private": true,
  "overrides": {
    "@sveltejs/kit": {
      "cookie": "0.7.2"
    }
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "dev:worker": "wrangler dev --local",
    "types:worker": "wrangler types",
    "types:worker:check": "wrangler types --check",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "backfill": "npx tsx scripts/backfill.ts",
    "backfill:fdic": "npx tsx scripts/fdic-backfill.ts",
    "maintenance:close": "npx tsx scripts/maintenance-close.ts",
    "lake:sod": "python scripts/fdic_sod_lake.py",
    "test:lake": "python -m unittest discover -s scripts/tests -p test_fdic_sod_lake.py",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretest:e2e": "npm run build",
    "test:e2e": "npx playwright test",
    "pretest:webmcp:e2e": "npm run build",
    "test:webmcp:e2e": "npx playwright test webmcp-native.spec.ts",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "smoke:seeded": "node scripts/ci-smoke.mjs",
    "fixture:verify": "node demo/fixtures/verify-demo.mjs && node --test demo/fixtures/fixture.test.mjs",
    "fixture:update": "node demo/fixtures/extract-demo.mjs",
    "demo:verify": "node scripts/webmcp-demo.mjs",
    "demo:webmcp": "npm run demo:verify",
    "check:release-assets": "node scripts/check-release-assets.mjs",
    "preflight:public": "node scripts/public-repo-preflight.mjs",
    "audit:data": "node scripts/audit-live-data.mjs",
    "audit:production": "npm audit --omit=dev --audit-level=high",
    "deploy:dry-run": "wrangler deploy --dry-run --outdir .wrangler/deploy-dry-run",
    "release:check": "npm run build && npm run types:worker:check && npm run typecheck && npm run test && npm run test:lake && npm run audit:production && npm run check:release-assets && npm run demo:verify && npm run test:e2e && npm run deploy:dry-run && npm run smoke:seeded",
    "ci": "npm run build && npm run types:worker:check && npm run typecheck && npm run test && npm run test:lake"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260901.1",
    "@playwright/test": "^1.58.2",
    "@sveltejs/adapter-cloudflare": "^7.2.9",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/vite": "^4.2.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.3.1",
    "@types/d3-geo": "^3.1.0",
    "@types/node": "^26.4.0",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "jsdom": "^28.1.0",
    "svelte": "^5.57.0",
    "svelte-check": "^4.4.5",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.0",
    "wrangler": "^4.128.0"
  },
  "dependencies": {
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "d3-geo": "^3.1.1",
    "echarts": "^6.1.0",
    "topojson-client": "^3.1.0"
  }
}
