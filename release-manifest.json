    ".kdbx",
    ".key",
    ".mov",
    ".mp3",
    ".mp4",
    ".ndjson",
    ".p12",
    ".parquet",
    ".pdf",
    ".pem",
    ".png",
    ".so",
    ".sqlite",
    ".sqlite-shm",
    ".sqlite-wal",
    ".sqlite3",
    ".tar",
    ".tsv",
    ".wav",
    ".webm",
    ".webp",
    ".zip"
