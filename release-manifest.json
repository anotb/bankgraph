    ".bak",
    ".bin",
    ".csv",
    ".db",
    ".db-shm",
    ".db-wal",
    ".dll",
    ".dmp",
    ".duckdb",
    ".dylib",
    ".exe",
    ".gif",
    ".gz",
    ".jpeg",
    ".jpg",
