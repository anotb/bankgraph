    "docs/security.md",
    "docs/sod-lakehouse.md",
    "docs/webmcp-catalog.md",
    "docs/webmcp-verification.md"
  ],
  "requiredPaths": [
    ".github/workflows/ci.yml",
    ".impeccable/design.json",
    "CONTRIBUTING.md",
    "DATA_NOTICE.md",
    "DESIGN.md",
    "LICENSE",
    "NOTICE",
    "PRIVACY.md",
    "README.md",
    "SECURITY.md",
    "THIRD_PARTY_NOTICES.md",
    "demo/fixtures/fixture-pin.json",
    "demo/fixtures/manifest.json",
    "docs/demo.md",
    "docs/webmcp-catalog.md",
    "docs/webmcp-verification.md"
  ],
  "forbiddenRoots": [
    ".claude",
    ".git",
    ".release-preflight",
    ".svelte-kit",
    ".wrangler",
    "data",
    "downloads",
    "exports",
    "node_modules",
    "output",
