{
  "schemaVersion": 1,
  "description": "Allowlist and safety limits for the public Bankgraph source release. This describes repository paths, not a deployment bundle.",
  "allowedRootFiles": [
    ".dev.vars.example",
    ".env.example",
    ".gitattributes",
    ".gitignore",
    "CONTRIBUTING.md",
    "DATA_NOTICE.md",
    "DESIGN.md",
    "LICENSE",
    "NOTICE",
    "PRIVACY.md",
    "PRODUCT.md",
    "README.md",
    "SECURITY.md",
    "THIRD_PARTY_NOTICES.md",
    "package-lock.json",
    "package.json",
    "playwright.config.ts",
    "release-manifest.json",
    "svelte.config.js",
    "tsconfig.json",
    "vite.config.ts",
    "vitest.config.ts",
    "worker-configuration.d.ts",
    "wrangler.jsonc"
  ],
  "allowedDirectories": [
    ".github",
    "demo",
    "LICENSES",
    "migrations",
    "scripts",
    "src",
    "static",
    "tests"
  ],
  "allowedFiles": [
    ".impeccable/design.json",
    "docs/bank-screen-api.md",
    "docs/data-and-methodology.md",
    "docs/data-quality.md",
    "docs/demo.md",
    "docs/deployment.md",
    "docs/fdic-backfills.md",
